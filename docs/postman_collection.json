    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/products?search=&min_price=&max_price=&in_stock=1&sort=created_at&direction=desc&per_page=15&page=1",
              "host": ["{{base_url}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "search", "value": "", "description": "Match title or description" },
                { "key": "min_price", "value": "" },
                { "key": "max_price", "value": "" },
                { "key": "in_stock", "value": "1", "description": "1 = only products with stock > 0" },
                { "key": "sort", "value": "created_at", "description": "price | title | created_at" },
                { "key": "direction", "value": "desc", "description": "asc | desc" },
                { "key": "per_page", "value": "15", "description": "1-100" },
                { "key": "page", "value": "1", "description": "Page number, starts at 1" }
              ]
            }
          },
          "response": [
            {
              "name": "200 OK",
