{
  "info": {
    "name": "Store API",
    "description": "REST API for a small online store: phone auth, product management, notifications, and concurrency-safe orders.\n\nSet the collection variables `base_url`, `token` (a regular user's bearer token) and `admin_token` (the seeded admin's token) after logging in.\n\nNote: OTP and notification SMS are delivered via the configured SMS gateway (`SMS_SENDER` in .env). By default (`log`) the message appears in `storage/logs/laravel.log`; set `SMS_SENDER=twilio` with TWILIO_* vars to send real SMS.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" },
    { "key": "admin_token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Saif Jamil\",\n  \"phone\": \"+201156683335\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
            }
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] },
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"Saif Jamil\",\n  \"phone\": \"+201156683335\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}" }
              },
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Account created. A verification code has been sent to your phone.\",\n  \"user\": {\n    \"id\": 1,\n    \"name\": \"Saif Jamil\",\n    \"phone\": \"+201156683335\",\n    \"is_admin\": false,\n    \"phone_verified_at\": null,\n    \"created_at\": \"2026-07-20T13:00:00+00:00\"\n  }\n}"
            },
            {
              "name": "422 Validation error",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] },
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"Saif Jamil\",\n  \"phone\": \"not-a-phone\",\n  \"password\": \"short\"\n}" }
              },
              "status": "Unprocessable Content",
              "code": 422,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"The phone field format is invalid. (and 1 more error)\",\n  \"errors\": {\n    \"phone\": [\"The phone field format is invalid.\"],\n    \"password\": [\"The password field confirmation does not match.\"]\n  }\n}"
            }
          ]
        },
        {
          "name": "Verify phone - request code",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/auth/verify-phone/request", "host": ["{{base_url}}"], "path": ["api", "auth", "verify-phone", "request"] },
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+201156683335\"\n}" }
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "POST", "header": [], "url": { "raw": "{{base_url}}/api/auth/verify-phone/request", "host": ["{{base_url}}"], "path": ["api", "auth", "verify-phone", "request"] } },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"If the phone number requires verification, a code has been sent.\"\n}"
            },
            {
              "name": "429 Too many requests",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "url": { "raw": "{{base_url}}/api/auth/verify-phone/request", "host": ["{{base_url}}"], "path": ["api", "auth", "verify-phone", "request"] },
                "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+201156683335\"\n}" }
              },
              "status": "Too Many Requests",
              "code": 429,
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "Retry-After", "value": "600" },
                { "key": "X-RateLimit-Limit", "value": "3" },
                { "key": "X-RateLimit-Remaining", "value": "0" }
              ],
              "body": "{\n  \"message\": \"Too many attempts. Please try again later.\"\n}"
            }
          ]
        },
        {
          "name": "Verify phone - confirm",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/auth/verify-phone", "host": ["{{base_url}}"], "path": ["api", "auth", "verify-phone"] },
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+201156683335\",\n  \"code\": \"123456\"\n}" }
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "POST", "header": [], "url": { "raw": "{{base_url}}/api/auth/verify-phone", "host": ["{{base_url}}"], "path": ["api", "auth", "verify-phone"] } },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Phone number verified.\"\n}"
            },
            {
              "name": "422 Invalid code",
              "originalRequest": { "method": "POST", "header": [], "url": { "raw": "{{base_url}}/api/auth/verify-phone", "host": ["{{base_url}}"], "path": ["api", "auth", "verify-phone"] } },
              "status": "Unprocessable Content",
              "code": 422,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Invalid or expired code.\",\n  \"errors\": {\n    \"code\": [\"Invalid or expired code.\"]\n  }\n}"
            }
          ]
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
